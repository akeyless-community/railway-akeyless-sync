# Akeyless authentication (choose one method)
AKEYLESS_ACCESS_ID=
AKEYLESS_ACCESS_KEY=
# Or use a pre-generated token:
# AKEYLESS_TOKEN=

# Optional: override Akeyless API URL (default: https://api.akeyless.io)
# AKEYLESS_API_URL=https://api.akeyless.io

# Railway GraphQL API — account or workspace token (NOT project token)
# Create at: https://railway.com/account/tokens
RAILWAY_API_TOKEN=

# Railway resource IDs (Cmd/Ctrl+K in Railway dashboard → Copy … ID)
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
# Optional — omit to sync shared environment variables
# RAILWAY_SERVICE_ID=

# Sync configuration
AKEYLESS_SECRET_PATH=/railway/my-project/production

# Prefix to strip from Akeyless item names when syncing (optional)
# SECRET_NAME_PREFIX=

# Skip variables reserved by Railway (default: true)
SKIP_RAILWAY_PREFIX=true
SKIP_REFERENCE_VARIABLES=true

# Delete Railway variables not present in Akeyless (default: false)
DELETE_ORPHANED=false

# Batch variable writes without redeploying services (default: false)
SKIP_DEPLOYS=false

# Replace all destination variables with only the Akeyless set (dangerous)
REPLACE_ALL=false
